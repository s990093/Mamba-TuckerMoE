          <tspan font-style="italic">U</tspan>
          <tspan font-style="italic" font-size="9.5" baseline-shift="sub">
            out
          </tspan>
        </text>

        <!-- Dense W_e — sliced iso cube showing E=8 expert layers, with E / d_in / d_out dimensions -->
