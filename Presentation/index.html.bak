<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Hybrid Mamba-TuckerMoE: Breaking the Memory Wall</title>
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.1.0/reveal.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.1.0/theme/white.min.css">
<script>window.MathJax={tex:{inlineMath:[['$','$']]},options:{skipHtmlTags:['script','noscript','style','textarea','pre']}};</script>
<script defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
<style>
/* ── design tokens ── */
:root{
  --navy:  #1a3356;
  --navy2: #0f2140;
  --orange:#e85d04;
  --blue:  #2e74c0;
  --green: #1a7a46;
  --light: #f0f4f8;
  --light2:#e8eef5;
  --text:  #1e293b;
  --muted: #64748b;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:Inter,'Helvetica Neue',Arial,sans-serif;}
.reveal,.reveal *{text-align:left;}
.reveal section{
  overflow:hidden!important;
  height:720px!important;
  padding:0!important;
  top:0!important;
  left:0!important;
}
/* ── header bar ── */
.sh{
  background:var(--navy2);color:#fff;
  height:46px;padding:0 22px;
  display:flex;justify-content:space-between;align-items:center;
  font-size:14px;font-weight:700;letter-spacing:.3px;
  border-bottom:3px solid var(--orange);
  flex-shrink:0;
}
.sh .pg{
  font-size:11px;font-weight:500;
  background:rgba(255,255,255,.12);
  padding:2px 8px;border-radius:10px;
  letter-spacing:.5px;
}
/* ── content area ── */
.sc{
  height:674px;padding:12px 20px;
  box-sizing:border-box;
  display:flex;flex-direction:column;
  overflow:hidden;
}
/* ── utility colours ── */
.co{color:var(--orange);}
.cn{color:var(--navy);}
.cb{color:var(--blue);}
.cg{color:var(--green);}
/* ── big numbers ── */
.bn{font-size:38px;font-weight:800;line-height:1;}
.bn2{font-size:28px;font-weight:800;line-height:1;}
/* ── stat box ── */
.sbox{
  border-radius:8px;padding:10px 14px;text-align:center;
  background:#fff;
  box-shadow:0 1px 4px rgba(0,0,0,.08);
}
/* ── card ── */
.card{
  border-radius:8px;padding:10px 14px;
  background:#fff;
  box-shadow:0 1px 3px rgba(0,0,0,.07);
}
/* ── table ── */
.dt{width:100%;border-collapse:collapse;font-size:12px;}
.dt th,.dt td{padding:5px 9px;text-align:center;}
.dt thead tr{background:var(--navy2);color:#fff;font-size:11px;font-weight:700;letter-spacing:.3px;}
.dt tbody tr:nth-child(even){background:var(--light);}
.dt tbody tr:hover{background:var(--light2);}
/* ── outline bullet (Outline slide) ── */
.ob{
  border-left:3px solid var(--orange);padding:8px 12px;
  font-size:13px;
  background:#fff;border-radius:0 6px 6px 0;
  box-shadow:0 1px 3px rgba(0,0,0,.06);
}
/* ── Reveal overrides ── */
.reveal .slides section .fragment{visibility:visible!important;}
.reveal pre{font-size:11px;}
</style>
</head>
<body>
<div class="reveal">
<div class="slides">

<!-- ═══════════════════════════════════════════════
     SLIDE 1  TITLE
═══════════════════════════════════════════════ -->
<section>
<div style="background:#2f4f4f;height:720px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:36px 60px;color:#fff;text-align:center;">
  <div style="font-size:11px;letter-spacing:3px;color:#7aacac;text-transform:uppercase;margin-bottom:14px;">ICLR 2026 · Research Presentation</div>
  <div style="font-size:38px;font-weight:800;line-height:1.12;margin-bottom:6px;">Breaking the Memory Wall:</div>
  <div style="font-size:32px;font-weight:700;color:#de5a28;line-height:1.15;margin-bottom:20px;">Compute-Bound TuckerMoE for Hybrid State Space Models</div>
  <div style="font-size:14px;color:#8db8b8;margin-bottom:28px;">Lai Hung-Wei &ensp;·&ensp; Apple Silicon M2 Pro &ensp;·&ensp; MLX Unified Memory Inference</div>
  <!-- 3 hero stats -->
  <div style="display:flex;gap:22px;justify-content:center;margin-bottom:26px;">
    <div style="background:rgba(255,255,255,.08);border:2.5px solid #de5a28;border-radius:10px;padding:16px 26px;text-align:center;min-width:160px;">
      <div style="font-size:42px;font-weight:800;color:#de5a28;line-height:1;">82.87%</div>
      <div style="font-size:11px;color:#8db8b8;margin-top:6px;">Compression<br>2.43B → 417M params</div>
    </div>
    <div style="background:rgba(255,255,255,.08);border:2.5px solid #5c7a99;border-radius:10px;padding:16px 26px;text-align:center;min-width:160px;">
      <div style="font-size:42px;font-weight:800;color:#8ab4cc;line-height:1;">32K</div>
      <div style="font-size:11px;color:#8db8b8;margin-top:6px;">Context Length<br>O(1) State Memory</div>
    </div>
    <div style="background:rgba(255,255,255,.08);border:2.5px solid #1b5e34;border-radius:10px;padding:16px 26px;text-align:center;min-width:160px;">
      <div style="font-size:42px;font-weight:800;color:#86efac;line-height:1;">3.32×</div>
      <div style="font-size:11px;color:#8db8b8;margin-top:6px;">Decode Speedup<br>SJD K=16 · 2048 tok</div>
    </div>
  </div>
  <div style="font-size:11px;color:#5a8888;">M2 Pro 16 GB &ensp;·&ensp; bf16 &ensp;·&ensp; Unified Memory &ensp;·&ensp; 68 tok/s (8-bit) &ensp;·&ensp; 42 tok/s (bf16)</div>
</div>
</section>

<!-- ═══════════════════════════════════════════════
     SLIDE 2  OUTLINE
═══════════════════════════════════════════════ -->
<section>
<div class="sh"><span>Talk Outline</span><span class="pg">2 / 12</span></div>
<div class="sc" style="justify-content:center;gap:10px;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;max-width:1100px;align-self:center;width:100%;">
    <div class="ob" style="border-color:#5c7a99;">
      <div style="font-weight:800;font-size:12px;color:#5c7a99;margin-bottom:3px;">00:00 — 01:00</div>
      <div style="font-weight:700;font-size:15px;">① Motivation &amp; Problem Setup</div>
      <div style="font-size:12px;color:#64748b;margin-top:2px;">Why attention and dense MoE both fail at scale on-device</div>
    </div>
    <div class="ob" style="border-color:#2f4f4f;">
      <div style="font-weight:800;font-size:12px;color:#2f4f4f;margin-bottom:3px;">01:00 — 02:30</div>
      <div style="font-weight:700;font-size:15px;">② System Architecture</div>
      <div style="font-size:12px;color:#64748b;margin-top:2px;">Macro block pipeline: 4× Mamba-3 + GQA Attn per layer</div>
    </div>
    <div class="ob" style="border-color:#de5a28;">
      <div style="font-weight:800;font-size:12px;color:#de5a28;margin-bottom:3px;">02:30 — 04:30</div>
      <div style="font-weight:700;font-size:15px;">③ Mamba-3 SSM &amp; Tucker Decomposition</div>
      <div style="font-size:12px;color:#64748b;margin-top:2px;">Trapezoidal discretization · W<sub>e</sub> ≈ U<sub>in</sub>·Core<sub>e</sub>·U<sub>out</sub></div>
    </div>
    <div class="ob" style="border-color:#de5a28;">
      <div style="font-weight:800;font-size:12px;color:#de5a28;margin-bottom:3px;">04:30 — 06:00</div>
      <div style="font-weight:700;font-size:15px;">④ TuckerMoE vs Standard MoE</div>
      <div style="font-size:12px;color:#64748b;margin-top:2px;">BW-bound → compute-bound via shared factor caching</div>
    </div>
    <div class="ob" style="border-color:#1b5e34;">
      <div style="font-weight:800;font-size:12px;color:#1b5e34;margin-bottom:3px;">06:00 — 07:30</div>
      <div style="font-weight:700;font-size:15px;">⑤ Multi-Stage Training &amp; CoT Loss</div>
      <div style="font-size:12px;color:#64748b;margin-top:2px;">3-stage curriculum · 5-weight ℒ<sub>CoT</sub> · FCP penalty</div>
    </div>
    <div class="ob" style="border-color:#5c7a99;">
      <div style="font-weight:800;font-size:12px;color:#5c7a99;margin-bottom:3px;">07:30 — 08:30</div>
      <div style="font-weight:700;font-size:15px;">⑥ Speculative Jacobi Decoding</div>
      <div style="font-size:12px;color:#64748b;margin-top:2px;">N-gram + Suffix + Phase · K=16 · 3.32× speedup</div>
    </div>
    <div class="ob" style="border-color:#2f4f4f;">
      <div style="font-weight:800;font-size:12px;color:#2f4f4f;margin-bottom:3px;">08:30 — 09:30</div>
      <div style="font-weight:700;font-size:15px;">⑦ Results &amp; Compression Study</div>
      <div style="font-size:12px;color:#64748b;margin-top:2px;">Memory comparison · Tucker vs SVD MSE · speedup table</div>
    </div>
    <div class="ob" style="border-color:#1b5e34;">
      <div style="font-weight:800;font-size:12px;color:#1b5e34;margin-bottom:3px;">09:30 — 10:00</div>
      <div style="font-weight:700;font-size:15px;">⑧ Conclusion &amp; Demo</div>
      <div style="font-size:12px;color:#64748b;margin-top:2px;">4 key contributions · live inference demo · Q&amp;A</div>
    </div>
  </div>
</div>
</section>

<!-- ═══════════════════════════════════════════════
     SLIDE 3  MOTIVATION
═══════════════════════════════════════════════ -->
<section>
<div class="sh"><span>Motivation</span><span class="pg">3 / 12</span></div>
<div class="sc" style="gap:10px;">
  <!-- 3 bottleneck cards -->
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;flex-shrink:0;">
    <div class="card" style="background:#fff3ee;border:2px solid #de5a28;">
      <div style="font-size:28px;font-weight:800;color:#de5a28;font-family:Helvetica,Arial,sans-serif;">O(N²)</div>
      <div style="font-size:14px;font-weight:700;color:#2f4f4f;margin:4px 0;">Attention Cost</div>
      <div style="font-size:12px;color:#64748b;line-height:1.4;">Quadratic complexity in sequence length. 32K context = <strong>1 billion</strong> attention pairs. Infeasible on 16 GB.</div>
    </div>
    <div class="card" style="background:#f0f4ff;border:2px solid #5c7a99;">
      <div style="font-size:28px;font-weight:800;color:#5c7a99;font-family:Helvetica,Arial,sans-serif;">O(N) KV</div>
      <div style="font-size:14px;font-weight:700;color:#2f4f4f;margin:4px 0;">KV Cache Growth</div>
      <div style="font-size:12px;color:#64748b;line-height:1.4;">Pure transformer KV cache grows linearly. At 32K context → OOM on M2 Pro. Mamba SSM state = <strong>14.1 MiB constant</strong>.</div>
    </div>
    <div class="card" style="background:#fff;border:2px solid #2f4f4f;">
      <div style="font-size:28px;font-weight:800;color:#2f4f4f;font-family:Helvetica,Arial,sans-serif;">BW-Bound</div>
      <div style="font-size:14px;font-weight:700;color:#2f4f4f;margin:4px 0;">Standard MoE</div>
      <div style="font-size:12px;color:#64748b;line-height:1.4;">Loading K=2 dense expert matrices per token = <strong>8 GB/token BW</strong>. Unified memory bottleneck.</div>
    </div>
  </div>
  <!-- research question -->
  <div style="background:#2f4f4f;border-radius:8px;padding:16px 20px;flex-shrink:0;">
    <div style="font-size:11px;color:#7aacac;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px;">Research Question</div>
    <div style="font-size:20px;font-weight:700;color:#fff;line-height:1.4;">
      Can we build a <span style="color:#de5a28;">2.4B dense-equivalent</span> model that fits on a 16 GB device,
      supports <span style="color:#86efac;">32K context</span>, and runs at practical speed
      using <span style="color:#de5a28;">Tucker-decomposed MoE</span>?
    </div>
  </div>
  <!-- answer row -->
  <div style="display:flex;gap:12px;flex-shrink:0;">
    <div class="sbox" style="flex:1;border:2px solid #de5a28;">
      <div class="bn2 co">Tucker MoE</div>
      <div style="font-size:11px;color:#64748b;margin-top:4px;">BW-bound → compute-bound<br>0.8 GB/token (10× less)</div>
    </div>
    <div class="sbox" style="flex:1;border:2px solid #5c7a99;">
      <div class="bn2 cb">Mamba-3 SSM</div>
      <div style="font-size:11px;color:#64748b;margin-top:4px;">O(1) state · 32K context<br>trapezoidal discretization</div>
    </div>
    <div class="sbox" style="flex:1;border:2px solid #1b5e34;">
      <div class="bn2 cg">3.32× Speedup</div>
      <div style="font-size:11px;color:#64748b;margin-top:4px;">Speculative Jacobi Decoding<br>K=16 · N-gram seeding</div>
    </div>
    <div class="sbox" style="flex:1;border:2px solid #2f4f4f;">
      <div class="bn2 cn">82.87%</div>
      <div style="font-size:11px;color:#64748b;margin-top:4px;">Compression 2.43B → 417M<br>45.3% lower MSE than SVD</div>
    </div>
  </div>
</div>
</section>

<!-- ═══════════════════════════════════════════════
     SLIDE 4  SYSTEM ARCHITECTURE
═══════════════════════════════════════════════ -->
<section>
<div class="sh"><span>System Architecture · Macro Block Pipeline</span><span class="pg">4 / 12</span></div>
<div class="sc" style="gap:10px;">
