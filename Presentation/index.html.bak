  <!-- RIGHT: formula + compression stats -->
  <div style="flex:1;display:flex;flex-direction:column;gap:10px;overflow:hidden;">
    <div style="background:#fff8f0;border:2px solid #de5a28;border-radius:8px;padding:14px 16px;">
      <div style="font-size:11px;letter-spacing:2px;color:#de5a28;text-transform:uppercase;margin-bottom:8px;font-family:Helvetica,Arial,sans-serif;">Core Decomposition Formula</div>
      <div style="font-size:22px;font-weight:800;color:#2f4f4f;line-height:1.4;">
        $W_e \approx U_{in} \cdot Core_e \cdot U_{out}$
      </div>
      <div style="font-size:12px;color:#64748b;margin-top:8px;line-height:1.5;">
        <span style="color:#5c7a99;font-weight:700;">U<sub>in</sub></span>: 1536×256 · shared across all experts<br>
        <span style="color:#de5a28;font-weight:700;">Core<sub>e</sub></span>: 32×512×256 · unique per expert (built from 32 shared slices)<br>
        <span style="color:#7c3aed;font-weight:700;">U<sub>out</sub></span>: 512×6144 · shared across all experts
      </div>
    </div>
    <!-- How Core_e is built -->
    <div style="background:#eff7f0;border:2px solid #1b5e34;border-radius:8px;padding:12px 14px;">
      <div style="font-size:13px;font-weight:700;color:#0a3d20;margin-bottom:6px;">
        How Core<sub>e</sub> is built — per-expert weighted sum:
      </div>
      <div style="font-size:16px;font-weight:800;color:#2f4f4f;">
        $Core_e = \sum_{r=1}^{32} u_r^{(e)} \cdot Core[r,:,:]$
      </div>
      <div style="font-size:11px;color:#1b5e34;margin-top:6px;">32 shared slices × per-expert weight vector → unique Core<sub>e</sub></div>
    </div>
    <!-- Compression stats -->
    <div style="background:#f4f7f9;border:2px solid #de5a28;border-radius:8px;padding:12px 14px;">
      <div style="font-size:11px;letter-spacing:2px;color:#de5a28;text-transform:uppercase;margin-bottom:8px;font-family:Helvetica,Arial,sans-serif;">Per-Expert Compression</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
        <div style="text-align:center;">
          <div style="font-size:26px;font-weight:800;color:#7f1d1d;">75.5M</div>
          <div style="font-size:11px;color:#64748b;">Dense W<sub>e</sub> params</div>
        </div>
        <div style="text-align:center;">
          <div style="font-size:26px;font-weight:800;color:#1b5e34;">7.39M</div>
          <div style="font-size:11px;color:#64748b;">Tucker params</div>
        </div>
      </div>
      <div style="background:#d1fae5;border:1.5px solid #1b5e34;border-radius:5px;padding:6px;text-align:center;margin-top:8px;">
        <span style="font-size:18px;font-weight:800;color:#0a3d20;">90.2% compression per expert</span>
      </div>
    </div>
    <!-- Tucker vs SVD teaser -->
    <div style="background:#fef2f2;border:2px solid #de5a28;border-radius:8px;padding:10px 14px;">
      <div style="font-size:13px;font-weight:700;color:#de5a28;">Tucker beats SVD at same compression:</div>
      <div style="display:flex;gap:16px;margin-top:6px;">
        <div style="text-align:center;flex:1;">
          <div style="font-size:20px;font-weight:800;color:#1b5e34;">0.00135</div>
          <div style="font-size:11px;color:#64748b;">Tucker MSE @82.87%</div>
        </div>
        <div style="text-align:center;flex:1;">
          <div style="font-size:20px;font-weight:800;color:#de5a28;">0.00247</div>
          <div style="font-size:11px;color:#64748b;">SVD MSE (+45.3% worse)</div>
        </div>
      </div>
    </div>
  </div>
</div>
</section>

