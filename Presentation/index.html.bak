<!-- ═══════════════════════════════════════════════
     SLIDE 5  MAMBA-3 SSM
═══════════════════════════════════════════════ -->
<section>
<div class="sh"><span>Mamba-3 State Space Model</span><span class="pg">5 / 12</span></div>
<div class="sc" style="gap:12px;">
  <!-- SSM equation -->
  <div style="background:#f4f7f9;border:2px solid #2f4f4f;border-radius:8px;padding:16px 20px;flex-shrink:0;">
    <div style="font-size:11px;letter-spacing:2px;color:#5c7a99;text-transform:uppercase;margin-bottom:10px;font-family:Helvetica,Arial,sans-serif;">Core SSM Equations — Trapezoidal Discretization</div>
    <div style="font-size:19px;font-weight:700;color:#2f4f4f;line-height:1.7;">
      $\bar{A}_t = \exp(\Delta_t A)$ &emsp; $\bar{B}_t = \tfrac{\Delta_t}{2}(\bar{A}_t + I)B_t$
    </div>
    <div style="font-size:19px;font-weight:700;color:#2f4f4f;line-height:1.7;margin-top:4px;">
      $h_t = \bar{A}_t\,h_{t-1} + \bar{B}_t\,x_t$ &emsp; $y_t = C_t\,h_t + D\,x_t$
    </div>
    <div style="font-size:12px;color:#5c7a99;margin-top:8px;font-style:italic;">
      Trapezoidal midpoint (vs Euler) · reduces discretization error · enables longer effective receptive field
    </div>
  </div>
  <!-- 4 key properties -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;flex-shrink:0;">
    <div class="card" style="background:#fff;border:2px solid #2f4f4f;display:flex;gap:12px;align-items:flex-start;">
      <div style="font-size:32px;line-height:1;flex-shrink:0;">🧠</div>
      <div>
        <div style="font-weight:800;font-size:15px;color:#2f4f4f;">O(1) State Memory</div>
        <div style="font-size:12px;color:#64748b;margin-top:3px;">SSM hidden state is fixed-size regardless of sequence length. 14.1 MiB at 32K context vs KV cache O(N).</div>
      </div>
    </div>
    <div class="card" style="background:#fff;border:2px solid #5c7a99;display:flex;gap:12px;align-items:flex-start;">
      <div style="font-size:32px;line-height:1;flex-shrink:0;">📏</div>
      <div>
        <div style="font-weight:800;font-size:15px;color:#5c7a99;">32K Context Window</div>
        <div style="font-size:12px;color:#64748b;margin-top:3px;">Mamba-3 trapezoidal discretization enables long sequences without quadratic cost. Dense FFN OOM &gt;16 GB.</div>
      </div>
    </div>
    <div class="card" style="background:#fff;border:2px solid #de5a28;display:flex;gap:12px;align-items:flex-start;">
      <div style="font-size:32px;line-height:1;flex-shrink:0;">🔄</div>
      <div>
        <div style="font-weight:800;font-size:15px;color:#de5a28;">RoPE on B, C Matrices</div>
        <div style="font-size:12px;color:#64748b;margin-top:3px;">Rotary positional embeddings applied to input/output projection matrices. Injects relative position without recurrence modification.</div>
      </div>
    </div>
    <div class="card" style="background:#fff;border:2px solid #1b5e34;display:flex;gap:12px;align-items:flex-start;">
      <div style="font-size:32px;line-height:1;flex-shrink:0;">⚡</div>
      <div>
        <div style="font-weight:800;font-size:15px;color:#1b5e34;">Chunk-Wise Parallel Scan</div>
        <div style="font-size:12px;color:#64748b;margin-top:3px;">Training via chunk parallelism. Inference via sequential O(1) recurrence. MLX bf16 compile: 47→70 tok/s baseline.</div>
      </div>
    </div>
  </div>
  <!-- key numbers row -->
  <div style="display:flex;gap:10px;flex-shrink:0;">
    <div class="sbox" style="flex:1;border:2px solid #2f4f4f;">
      <div class="bn2 cn">768</div><div style="font-size:11px;color:#64748b;">model dim d</div>
    </div>
    <div class="sbox" style="flex:1;border:2px solid #5c7a99;">
      <div class="bn2 cb">16</div><div style="font-size:11px;color:#64748b;">SSM state N</div>
    </div>
    <div class="sbox" style="flex:1;border:2px solid #de5a28;">
      <div class="bn2 co">32K</div><div style="font-size:11px;color:#64748b;">max seq len</div>
    </div>
    <div class="sbox" style="flex:1;border:2px solid #1b5e34;">
      <div class="bn2 cg">14.1 MiB</div><div style="font-size:11px;color:#64748b;">SSM state @32K</div>
    </div>
    <div class="sbox" style="flex:1;border:2px solid #2f4f4f;">
      <div class="bn2 cn">bf16</div><div style="font-size:11px;color:#64748b;">compute dtype</div>
    </div>
  </div>
</div>
</section>

