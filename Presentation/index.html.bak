<!-- ═══════════════════════════════════════════════
     SLIDE 10  RESULTS
═══════════════════════════════════════════════ -->
<section>
<div class="sh"><span>Results · Compression, Memory &amp; Speedup</span><span class="pg">10 / 12</span></div>
<div class="sc" style="gap:8px;padding:8px 18px;">
  <!-- 5 stat boxes -->
  <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;flex-shrink:0;">
    <div class="sbox" style="border:2.5px solid #2f4f4f;">
      <div style="font-size:28px;font-weight:800;color:#2f4f4f;line-height:1;">82.87%</div>
      <div style="font-size:10px;color:#64748b;margin-top:4px;">Compression<br>2.43B→417M</div>
    </div>
    <div class="sbox" style="border:2.5px solid #de5a28;background:#fff;">
      <div style="font-size:28px;font-weight:800;color:#2f4f4f;line-height:1;">~90%</div>
      <div style="font-size:10px;color:#64748b;margin-top:4px;">Inference Cost<br>Reduction</div>
    </div>
    <div class="sbox" style="border:2.5px solid #5c7a99;">
      <div style="font-size:28px;font-weight:800;color:#2f4f4f;line-height:1;">2.4B</div>
      <div style="font-size:10px;color:#64748b;margin-top:4px;">Dense-Equiv<br>Capacity</div>
    </div>
    <div class="sbox" style="border:2.5px solid #1b5e34;">
      <div style="font-size:22px;font-weight:800;color:#1b5e34;line-height:1;">0.00135</div>
      <div style="font-size:10px;color:#64748b;margin-top:4px;">Tucker MSE<br>@82.87%</div>
    </div>
    <div class="sbox" style="border:2.5px solid #de5a28;background:#fff;">
      <div style="font-size:22px;font-weight:800;color:#de5a28;line-height:1;">0.00247</div>
      <div style="font-size:10px;color:#64748b;margin-top:4px;">SVD MSE<br>+45.3% worse</div>
    </div>
  </div>
  <!-- 2-column: Memory table + Speedup table -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;flex:1;overflow:hidden;">
    <!-- Memory comparison -->
    <div style="border:2px solid #2f4f4f;border-radius:6px;overflow:hidden;font-family:'Times New Roman',Times,serif;">
      <div style="background:#2f4f4f;color:#fff;font-family:Helvetica,Arial,sans-serif;font-size:12px;font-weight:700;text-align:center;padding:6px;">Decode Memory (M2 Pro, bf16)</div>
